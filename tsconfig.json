        "declaration": false,
        "target": "esnext",
        "lib": ["esnext"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "skipLibCheck": true,
        "strict": true,
        "types": ["node"]
    },
    "include": ["./**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
